#!/usr/bin/env bash

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
conventional_commit_regex="$(cat "${hook_dir}/conventional-commit.pattern")"

commit_message_file="$1"
if [[ -z "$commit_message_file" || ! -f "$commit_message_file" ]]; then
    printf "\e[31mError: The commit message file was not provided or does not exist.\e[0m\n"
    exit 1
fi

# The hook receives the commit message before Git removes comment lines and leading blank lines.
# The message is therefore cleaned up in the same way, so that the evaluated subject line is
# identical to the one that is stored and validated by the commit-message workflow.
commit_subject="$(git stripspace --strip-comments < "$commit_message_file" | head -n 1)"
if [[ -z "$commit_subject" ]]; then
    printf "\e[31mError: The commit message is empty. The commit has been aborted.\e[0m\n"
    exit 1
fi

if [[ "$commit_subject" =~ $conventional_commit_regex ]]; then
    printf "\e[32mThe commit message meets the Conventional Commits standard.\e[0m\n"
    exit 0
fi

printf "\e[31mThe commit message does not meet the Conventional Commits standard.\e[0m\n"
echo "Evaluated subject line:"
echo "  ${commit_subject}"
echo
echo "Example of a valid message:"
echo "  feat(login): ABC-123 add the 'remember me' button"
echo "Further details are provided at https://www.conventionalcommits.org/en/v1.0.0/#summary"
exit 1
